/tracker.js
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/vsl.js
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex
  Cache-Control: no-cache

/index.html
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# El dashboard: el navegador comprueba siempre si hay versión nueva (si no cambió, no se vuelve a descargar).
/js/*
  Cache-Control: no-cache

/styles.css
  Cache-Control: no-cache

/tema.js
  Cache-Control: no-cache

# Librerías para leer PDF y Word en el navegador (documentos de Marca y avatar): versión fija en la ruta.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Cuestionario de marca del cliente (enlace privado con su clave en la URL): que no se indexe ni se filtre.
/marca.html
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
  Cache-Control: no-cache
