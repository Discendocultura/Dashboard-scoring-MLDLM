# GoHighLevel → Ajustes → Integraciones privadas → crear token
GHL_TOKEN=pit-xxxxxxxx
GHL_LOCATION_ID=Uxda6Ag6FfezFhIdtabk

# Contraseñas del dashboard (admin: todo; setter: ver leads y enviar WhatsApp)
ADMIN_PASSWORD=
SETTER_PASSWORD=
# Cadena aleatoria larga para firmar la sesión (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=

# Zoom → marketplace.zoom.us → Build App → Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Opcionales ---
# Meta Ads (inversión, CPL, ROAS y nombres de campañas/anuncios). Token de "usuario del sistema" con ads_read.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Cloudflare Turnstile (anti-bots en el registro desde la página de recursos y el directo)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Clave para que un programador de tareas lance el resumen diario: /api/digest?key=...
DIGEST_KEY=

# SendFlow (grupos de WhatsApp): SendFlow → API Keys. Otros clientes: SENDFLOW_API_KEY_<CLIENTE>
SENDFLOW_API_KEY=
